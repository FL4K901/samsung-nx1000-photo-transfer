<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#38383A" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="@color/ios_card_stroke" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#1C1C1E" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#2C2C2E" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ios_card_elevated" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="@color/ios_card_stroke" />
        </shape>
    </item>
</selector>
