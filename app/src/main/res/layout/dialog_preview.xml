<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/card_bg">

    <TextView
        android:id="@+id/dialog_preview_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SAM_0001.JPG"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <ImageView
        android:id="@+id/dialog_preview_image"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:scaleType="fitCenter"
        android:background="#20000000" />

    <TextView
        android:id="@+id/dialog_preview_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Size: 4.5 MB | Date: 2024-05-12"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/dialog_btn_close"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/button_secondary"
            android:text="@string/preview_close"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/dialog_btn_download"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.6"
            android:layout_marginLeft="10dp"
            android:background="@drawable/button_primary"
            android:text="@string/preview_download_single"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
