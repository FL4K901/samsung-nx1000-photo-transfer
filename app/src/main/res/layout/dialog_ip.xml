<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/card_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_ip_title"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_ip_msg"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginTop="6dp" />

    <EditText
        android:id="@+id/edit_camera_ip"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="192.168.107.1"
        android:hint="192.168.107.1"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:singleLine="true"
        android:inputType="textUri"
        android:layout_marginTop="14dp"
        android:padding="12dp"
        android:background="@drawable/card_inner" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="פורט (ריק = סריקה אוטומטית של פורטים 52235, 7676, 8080):"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/edit_camera_port"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:hint="52235"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:singleLine="true"
        android:inputType="number"
        android:layout_marginTop="4dp"
        android:padding="12dp"
        android:background="@drawable/card_inner" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/dialog_ip_cancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/button_secondary"
            android:text="@string/dialog_cancel"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/dialog_ip_connect"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:background="@drawable/button_primary"
            android:text="@string/dialog_ip_connect"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
