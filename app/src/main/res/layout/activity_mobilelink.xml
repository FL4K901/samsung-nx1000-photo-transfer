<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_bg">

    <!-- Top Fixed Container: iOS Header with Back Navigation & Status -->
    <LinearLayout
        android:id="@+id/layout_top_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentTop="true"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:background="@color/ios_bg">

        <!-- Navigation Bar: Back Button + Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btn_back_to_home"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/button_secondary"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back"
                android:padding="8dp"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_screen_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MobileLink"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Browse &amp; Transfer Camera Photos"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Dynamic Island Status Capsule -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:background="@drawable/island_capsule"
            android:padding="8dp">

            <TextView
                android:id="@+id/txt_status_badge"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:background="@drawable/badge_disconnected"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="@string/status_not_connected"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- Scan progress indicator -->
            <ProgressBar
                android:id="@+id/progress_scan"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:indeterminate="true"
                android:visibility="gone"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Action Pills Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btn_scan_camera"
                style="@style/ApplePillButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1.3"
                android:background="@drawable/button_accent"
                android:text="@string/btn_scan"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_open_wifi"
                style="@style/ApplePillButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginLeft="6dp"
                android:background="@drawable/button_secondary"
                android:text="@string/btn_wifi_settings"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_direct_ip"
                style="@style/ApplePillButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="0.8"
                android:layout_marginLeft="6dp"
                android:background="@drawable/button_secondary"
                android:text="@string/btn_direct_ip"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Main Content: Empty State Instructions or Photo Grid -->
    <FrameLayout
        android:id="@+id/layout_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layout_top_header"
        android:layout_above="@+id/layout_batch_controls">

        <!-- Photo Grid View -->
        <GridView
            android:id="@+id/grid_photos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="3"
            android:verticalSpacing="6dp"
            android:horizontalSpacing="6dp"
            android:stretchMode="columnWidth"
            android:padding="8dp"
            android:clipToPadding="false"
            android:layout_marginBottom="76dp"
            android:visibility="gone" />

        <!-- Empty State Instructions -->
        <ScrollView
            android:id="@+id/scroll_empty_instructions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="How to Connect to MobileLink:"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Card: Step by step -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Step 1: Set Camera to MobileLink"
                        android:textColor="@color/ios_blue"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Turn mode dial to Wi-Fi, select MobileLink, and choose 'Select files from smartphone'."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Step 2: Connect Phone Wi-Fi"
                        android:textColor="@color/ios_blue"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Connect phone Wi-Fi to camera network (e.g. NX1000...)."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Step 3: Connect &amp; Browse"
                        android:textColor="@color/ios_green"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tap 'Connect Camera' above. The app connects and loads your photos automatically."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>

                <!-- Tip Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_inner"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tip: Power Off Time"
                        android:textColor="@color/status_orange_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="In camera settings (wrench icon), change 'Power Off Time' to 5 or 10 minutes so Wi-Fi does not shut off prematurely."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- Bottom Floating Bar: iOS Batch Controls -->
    <LinearLayout
        android:id="@+id/layout_batch_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/floating_bar_bg"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:orientation="vertical"
        android:elevation="12dp"
        android:visibility="gone">

        <!-- Top status inside bar: Selection Counter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/txt_selection_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0 selected"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Select/Deselect All Toggle -->
            <Button
                android:id="@+id/btn_select_all"
                style="@style/ApplePillButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/button_secondary"
                android:text="@string/btn_select_all"
                android:textColor="@color/ios_blue"
                android:textSize="12sp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />
        </LinearLayout>

        <!-- Main Action: Download Selected Button -->
        <Button
            android:id="@+id/btn_download_selected"
            style="@style/ApplePillButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/button_primary"
            android:text="@string/btn_download_selected"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="-0.01"
            android:enabled="false" />

    </LinearLayout>

    <!-- Download Progress Overlay Bar -->
    <LinearLayout
        android:id="@+id/layout_download_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:background="@drawable/floating_bar_bg"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="16dp"
        android:elevation="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txt_download_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/downloading_photos"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center" />

        <ProgressBar
            android:id="@+id/progress_download"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="10dp"
            android:progressDrawable="@drawable/badge_searching" />
    </LinearLayout>

</RelativeLayout>
