<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_bg">

    <!-- Top Fixed Container: iOS Header with Back Navigation & Status -->
    <LinearLayout
        android:id="@+id/layout_top_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentTop="true"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:background="@color/ios_bg">

        <!-- Navigation Bar: Back Button + Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btn_back_to_home"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/button_secondary"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="חזרה"
                android:padding="8dp"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_screen_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MobileLink"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="העברת תמונות וסרטונים מהמצלמה"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Dynamic Island Status Capsule -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:background="@drawable/island_capsule"
            android:padding="8dp">

            <TextView
                android:id="@+id/txt_status_badge"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:background="@drawable/badge_disconnected"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="@string/status_not_connected"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- Scan progress indicator -->
            <ProgressBar
                android:id="@+id/progress_scan"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:indeterminate="true"
                android:visibility="gone"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Action Pills Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_scan_camera"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1.4"
                android:background="@drawable/button_primary"
                android:text="סרוק וחבר מצלמה"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_open_wifi"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1.1"
                android:layout_marginLeft="6dp"
                android:background="@drawable/button_secondary"
                android:text="הגדרות Wi-Fi"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_direct_ip"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="0.9"
                android:layout_marginLeft="6dp"
                android:background="@drawable/button_secondary"
                android:text="IP ישיר"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Main Content Area -->
    <FrameLayout
        android:id="@+id/layout_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layout_top_header"
        android:layout_marginBottom="0dp">

        <!-- Empty State Instructions -->
        <ScrollView
            android:id="@+id/scroll_empty_instructions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="הוראות חיבור למצב MobileLink"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingLeft="6dp"
                    android:paddingBottom="6dp" />

                <!-- Grouped Card Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/card_inner"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1. במצלמה: בחר במצב MobileLink"
                            android:textColor="@color/ios_green"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="העבר את חוגת המצבים ל-Wi-Fi, בחר MobileLink ובחר 'כל הקבצים' או 'בחירה בסמארטפון'."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/card_inner"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2. אישור במצלמה (חשוב!)"
                            android:textColor="@color/ios_orange"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="כאשר המצלמה שואלת 'האם לאשר חיבור לסמארטפון?', לחץ מיד על 'כן' (Yes) במצלמה."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/card_inner"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3. חיבור באפליקציה"
                            android:textColor="@color/ios_blue"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ודא שהטלפון מחובר לרשת ה-Wi-Fi של המצלמה, ולחץ למעלה על 'סרוק וחבר מצלמה'."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Photo Grid View -->
        <GridView
            android:id="@+id/grid_photos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="3"
            android:verticalSpacing="4dp"
            android:horizontalSpacing="4dp"
            android:stretchMode="columnWidth"
            android:padding="4dp"
            android:clipToPadding="false"
            android:layout_marginBottom="72dp"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Floating Glass Batch Control Bar -->
    <LinearLayout
        android:id="@+id/layout_batch_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="14dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/floating_bar_bg"
        android:padding="10dp"
        android:gravity="center_vertical"
        android:elevation="12dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_select_all"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/button_secondary"
            android:text="בחר הכל"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp" />

        <TextView
            android:id="@+id/txt_selection_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 נבחרו"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:gravity="center" />

        <Button
            android:id="@+id/btn_download_selected"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/button_accent"
            android:text="הורד נבחרים"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingLeft="14dp"
            android:paddingRight="14dp" />
    </LinearLayout>

    <!-- Batch Download Progress Overlay -->
    <LinearLayout
        android:id="@+id/layout_download_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="14dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/floating_bar_bg"
        android:padding="16dp"
        android:elevation="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txt_download_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="מוריד קבצים..."
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center" />

        <ProgressBar
            android:id="@+id/progress_download"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="10dp"
            android:progressDrawable="@drawable/badge_searching" />
    </LinearLayout>

</RelativeLayout>
