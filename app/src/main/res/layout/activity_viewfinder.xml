<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Top Fixed Container: Header with Back Navigation & Status -->
    <LinearLayout
        android:id="@+id/layout_rvf_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentTop="true"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:background="#0A0A0C">

        <!-- Navigation Bar: Back Button + Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btn_rvf_back_to_home"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/button_secondary"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="חזרה"
                android:padding="8dp"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remote Viewfinder"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="עינית חיה ושליטה על צילום מרחוק"
                    android:textColor="#8E8E93"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Status Capsule -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:background="@drawable/island_capsule"
            android:padding="8dp">

            <TextView
                android:id="@+id/txt_rvf_status_badge"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:background="@drawable/badge_disconnected"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="ממתין לחיבור עם המצלמה במצב Remote Viewfinder"
                android:textColor="#8E8E93"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- Scan progress indicator -->
            <ProgressBar
                android:id="@+id/progress_rvf_scan"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:indeterminate="true"
                android:visibility="gone"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Action Pills Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_rvf_connect"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1.4"
                android:background="@drawable/button_accent"
                android:text="התחבר לעינית"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_rvf_wifi"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1.1"
                android:layout_marginLeft="8dp"
                android:background="@drawable/button_secondary"
                android:text="הגדרות Wi-Fi"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Center Live Viewfinder Viewport -->
    <FrameLayout
        android:id="@+id/layout_rvf_viewport"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layout_rvf_header"
        android:layout_above="@+id/layout_rvf_controls"
        android:background="#121214"
        android:layout_margin="14dp">

        <ImageView
            android:id="@+id/img_rvf_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="Live Preview Feed" />

        <!-- Viewport Placeholder & Reticle -->
        <LinearLayout
            android:id="@+id/layout_rvf_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_card_viewfinder"
                android:contentDescription="Camera Lens"
                android:alpha="0.6" />

            <TextView
                android:id="@+id/txt_rvf_instructions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. במצלמה: סובב את החוגה ל-Wi-Fi ובחר Remote Viewfinder.\n2. חבר את הטלפון לרשת ה-Wi-Fi של המצלמה.\n3. לחץ למעלה על 'התחבר לעינית'."
                android:textColor="#8E8E93"
                android:textSize="13sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="16dp" />
        </LinearLayout>

    </FrameLayout>

    <!-- Bottom Controls: Apple Camera Style Shutter & Bar -->
    <LinearLayout
        android:id="@+id/layout_rvf_controls"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:background="#0A0A0C"
        android:padding="16dp">

        <!-- Shutter Button (Apple Camera White Ring Style) -->
        <FrameLayout
            android:id="@+id/btn_rvf_shutter"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/badge_connected"
            android:clickable="true"
            android:focusable="true">

            <View
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:background="@drawable/badge_disconnected" />
        </FrameLayout>

    </LinearLayout>

</RelativeLayout>
